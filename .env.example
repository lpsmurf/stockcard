# ── Client (NEXT_PUBLIC_*) ──────────────────────────────────────────────
NEXT_PUBLIC_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
NEXT_PUBLIC_PROGRAM_ID=HsXyxfSvp7mha6bxgh3Qr9NoVmMVe6HmynVguRfBLWrY
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mock dUSDC (6 decimals, mint authority = FAUCET_AUTHORITY_SECRET) — written by scripts/seed-devnet.ts
NEXT_PUBLIC_USDC_MINT=

# Collateral mints — written by scripts/seed-devnet.ts
NEXT_PUBLIC_MINT_NVDAX=
NEXT_PUBLIC_MINT_SPYX=
NEXT_PUBLIC_MINT_TSLAX=
NEXT_PUBLIC_MINT_SPCX=
# Pre-IPO (Tessera, PreStocks) — devnet mocks created by scripts/seed-devnet.ts
NEXT_PUBLIC_MINT_T_OPENAI=
NEXT_PUBLIC_MINT_T_KALSHI=
NEXT_PUBLIC_MINT_PRE_ANTHROPIC=
NEXT_PUBLIC_MINT_PRE_SPACEX=
NEXT_PUBLIC_MINT_TIDE=
NEXT_PUBLIC_MINT_CC_LUGIA=
NEXT_PUBLIC_MINT_CC_RAYQUAZA=
NEXT_PUBLIC_MINT_CC_MEW=
NEXT_PUBLIC_MINT_CC_DAYTONA=
NEXT_PUBLIC_MINT_CC_ROYALOAK=
NEXT_PUBLIC_MINT_CC_SEAMASTER=

# Web push (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Switchboard feeds — set ONLY if the Wednesday spike passes (T029b)
NEXT_PUBLIC_SWITCHBOARD_FEED_SPYX=
NEXT_PUBLIC_SWITCHBOARD_FEED_TSLAX=

# ── Server-only (never NEXT_PUBLIC_, never commit real values) ──────────
CARD_PROVIDER=mock
CARD_AUTHORITY_SECRET=
CASHBACK_AUTHORITY_SECRET=
FAUCET_AUTHORITY_SECRET=
ADMIN_SECRET=
ADMIN_TOKEN=
MERCHANT_SETTLEMENT_ADDRESS=
SHOP_TREASURY_ADDRESS=

# Persistent KV (unset -> in-memory store for local dev)
# Preferred: Upstash Redis REST
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Fallback used for the Sept 17 demo deploy (Upstash `*.upstash.io` was unreachable
# from this network): a secret GitHub Gist storing a JSON document. Create a gist
# with a file named `stockcard-kv.json` containing `{}` and set:
KV_GIST_ID=
KV_GITHUB_TOKEN=

# Web push server side
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:littleplu@gmail.com

# Scheduler shared secret (/api/prices/sync, /api/alerts/check)
CRON_SECRET=
QSTASH_TOKEN=

# Optional integrations
JUPITER_API_KEY=
# Pyth Hermes key (required by Pyth since 26 Aug 2026). Without it the signer
# runs on xStocks + Jupiter only. PYTH_FEED_IDS optionally pins feed ids:
# {"NVDAx":"0x...","SPYx":"0x...","TSLAx":"0x..."}
PYTH_API_KEY=
PYTH_FEED_IDS=
COLLECTORCRYPT_API_KEY=
PSA_API_TOKEN=
BRIDGE_API_KEY=
STRIPE_SECRET_KEY=
